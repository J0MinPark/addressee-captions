[
 {
  "who": "W",
  "text": "안녕하세요, 혹시 여기 자리 있어요?",
  "t_start": 0.8,
  "t_end": 3.738,
  "label": "w"
 },
 {
  "who": "P",
  "text": "아니요, 비어 있어요. 앉으세요.",
  "t_start": 4.088,
  "t_end": 6.575,
  "label": "y"
 },
 {
  "who": "W",
  "text": "감사합니다. 오늘 사람 진짜 많네요.",
  "t_start": 7.075,
  "t_end": 10.34,
  "label": "w"
 },
 {
  "who": "P",
  "text": "그러게요, 주말이라 그런가 봐요.",
  "t_start": 10.74,
  "t_end": 12.485,
  "label": "y"
 },
 {
  "who": "C",
  "text": "내일 회의 몇 시였는지 기억나?",
  "t_start": 15.485,
  "t_end": 18.067,
  "label": "n"
 },
 {
  "who": "D",
  "text": "아마 열 시였을 거야.",
  "t_start": 18.567,
  "t_end": 19.35,
  "label": "n"
 },
 {
  "who": "W",
  "text": "혹시 와이파이 비밀번호 아세요?",
  "t_start": 21.85,
  "t_end": 24.023,
  "label": "w"
 },
 {
  "who": "C",
  "text": "야 지훈아, 너 어제 그 경기 봤어? 진짜 대박이더라.",
  "t_start": 24.323,
  "t_end": 30.549,
  "label": "n"
 },
 {
  "who": "P",
  "text": "카운터 옆에 적혀 있던데요.",
  "t_start": 31.149,
  "t_end": 32.532,
  "label": "y"
 },
 {
  "who": "W",
  "text": "아 그렇구나, 고마워요.",
  "t_start": 33.032,
  "t_end": 35.034,
  "label": "w"
 },
 {
  "who": "P",
  "text": "저는 여기 자주 오는데 오늘처럼 붐비는 건 처음이에요.",
  "t_start": 35.434,
  "t_end": 38.106,
  "label": "y"
 },
 {
  "who": "SIREN",
  "text": "",
  "t_start": 40.106,
  "t_end": 43.106,
  "label": "-"
 },
 {
  "who": "C",
  "text": "민수야, 이거 좀 봐봐.",
  "t_start": 44.106,
  "t_end": 46.723,
  "label": "n"
 },
 {
  "who": "W",
  "text": "네? 저 부르셨어요?",
  "t_start": 47.323,
  "t_end": 49.38,
  "label": "w"
 },
 {
  "who": "D",
  "text": "아니 너 말고, 저쪽 민수.",
  "t_start": 49.78,
  "t_end": 51.099,
  "label": "y"
 },
 {
  "who": "W",
  "text": "커피는 어떤 게 맛있어요?",
  "t_start": 54.099,
  "t_end": 56.042,
  "label": "w"
 },
 {
  "who": "P",
  "text": "여기는 라떼가 제일 괜찮아요.",
  "t_start": 56.442,
  "t_end": 57.989,
  "label": "y"
 },
 {
  "who": "W",
  "text": "그럼 라떼 마셔 볼게요.",
  "t_start": 58.489,
  "t_end": 60.051,
  "label": "w"
 },
 {
  "who": "D",
  "text": "근데 우리 몇 시에 나가야 돼?",
  "t_start": 60.401,
  "t_end": 61.425,
  "label": "n"
 },
 {
  "who": "C",
  "text": "한 시간쯤 뒤에.",
  "t_start": 61.925,
  "t_end": 63.47,
  "label": "n"
 },
 {
  "who": "P",
  "text": "여기 디저트도 맛있어요. 케이크 추천해요.",
  "t_start": 67.47,
  "t_end": 70.258,
  "label": "y"
 }
]