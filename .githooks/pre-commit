#!/usr/bin/env bash
# 커밋 전 전체 테스트. 실패하면 커밋을 막는다. 통합 테스트(test_integration_replay)는 5회 반복(순서 경쟁 회귀 방지).
# 설치: git config core.hooksPath .githooks   (scripts/install_hooks.sh)
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
PY="${HEARME_PY:-$ROOT/.venv/bin/python}"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"
export CUDA_DEVICE_ORDER=PCI_BUS_ID CUDA_VISIBLE_DEVICES="${HEARME_GPU:-2}"
echo "[pre-commit] 전체 테스트"
"$PY" -m pytest -q tests 2>&1 | tail -n 5
for i in 2 3 4 5; do
  echo "[pre-commit] 통합 테스트 반복 $i/5"
  "$PY" -m pytest -q tests/test_integration_replay.py 2>&1 | tail -n 2
done
echo "[pre-commit] 통과"
